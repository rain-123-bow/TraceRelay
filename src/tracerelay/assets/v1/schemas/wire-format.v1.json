    "mailbox_rule": "ordinary workers use one fixed-size command mailbox and one result mailbox with exactly one in-flight operation. Each alarm worker uses one independent preallocated in-place slot mapping defined by alarm_slot: persistent roles have exactly alarm_ipc_limits.persistent_slots_per_worker=2 slots and live roles have exactly alarm_ipc_limits.live_slots_per_worker=1024 slots. A worker replaces the command with its result in the same slot. Every worker has separate command-ready and result-ready events. No result ring, dynamic alarm mapping, send, wait-for-space, or peer-channel object exists."
  },
  "alarm_mapping_header": {
    "serialization_id": "TraceRelay.AlarmMappingHeader.v1",
    "total_bytes_profile_key": "alarm_ipc_limits.mapping_header_bytes",
    "total_bytes": 32,
    "byte_order": "little-endian",
    "atomic_alignment_rule": "every 32-bit field is naturally 4-byte aligned and every 64-bit field is naturally 8-byte aligned; all reads, stores, compare/exchanges, increments, and decrements use the plan-owned _winatomic ABI with at least the requirement-owned acquire/release ordering",
    "layout": [
      {"name": "freeze_state", "offset": 0, "bytes": 4, "type": "U32", "enum": {"1": "RUNNING", "2": "FREEZE_REQUESTED", "3": "FROZEN"}},
      {"name": "reserved", "offset": 4, "bytes": 4, "type": "U32", "required": 0},
      {"name": "freeze_generation", "offset": 8, "bytes": 8, "type": "U64"},
      {"name": "active_transition_count", "offset": 16, "bytes": 8, "type": "U64"},
      {"name": "snapshot_sequence", "offset": 24, "bytes": 8, "type": "U64"}
    ],
    "slot_offset_rule": "slot i begins at 32 + i * 4352",
    "normal_transition_order": [
      "atomically increment active_transition_count",
      "acquire-load freeze_generation and freeze_state; require generation zero and state RUNNING or decrement without slot mutation",
      "acquire an even snapshot_sequence s by CAS to s+1; while contended recheck generation/state and abort before mutation if freeze began",
      "after owning odd s+1 recheck generation/state; if freeze won publish s+2 and decrement without slot mutation",
      "perform at most one requirement-valid TRAS/1 slot-state CAS and associated field publication",
      "release-publish s+2",
      "release-decrement active_transition_count on every exit path"
    ],
    "recovery_order": [
      "CAS freeze_generation from zero to expected generation, or require exact same generation when resuming",
      "CAS freeze_state from RUNNING to FREEZE_REQUESTED",
      "wait for or validly normalize active_transition_count to zero and snapshot_sequence to even only after every mutator is EXITED or IDENTITY_ABSENT",
      "acquire-read one stable slot snapshot while count is zero and sequence is the same even value before and after",
      "release-store FROZEN irreversibly"
    ],
    "normalization_rule": "alive QUIESCED is insufficient; no slot state is synthesized or rolled back; a different nonzero generation is conflict; FROZEN never returns to RUNNING",
    "validation_rule": "reserved is zero; RUNNING has generation zero during normal operation; a recovery attempt reuses its already-derived generation after a crash before attempt-file creation; invalid state, misalignment, overflow, underflow, odd stable snapshot, or violated order is fatal"
  },
