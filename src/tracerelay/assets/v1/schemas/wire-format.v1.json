    ],
    "state_codes": {
      "0": "EMPTY",
      "1": "COMMAND_WRITING",
      "2": "COMMAND_READY",
      "3": "WORKER_EXECUTING",
      "4": "RESULT_WRITING",
      "5": "RESULT_READY",
      "6": "CONSUMER_VALIDATING",
      "7": "OBSERVATION_COMMITTING",
      "8": "REJECTION_COMMITTING",
      "9": "LATE_DIAGNOSTIC_COMMITTING",
      "10": "ACKED",
      "11": "POISONED"
    },
    "state_field_matrix": {
      "always_required": ["state", "slot_index", "slot_epoch", "channel", "emission", "mapping_incarnation_id"],
      "fixed_slot_role_rule": "channel, emission, slot_index, and mapping_incarnation_id describe the preallocated slot role and remain byte-identical across every transition, including EMPTY and POISONED",
      "zero_group_names": {
        "execution_binding": ["worker_incarnation_id", "operation_id", "alarm_id", "call_emission_id", "session_id", "command_admitted_qpc", "dispatch_return_qpc", "applicable_deadline_qpc", "dispatch_sha256"],
        "returned_result": ["result_category", "validation_state", "call_return_qpc", "validation_completed_qpc", "windows_error"],
        "payload": ["payload_bytes", "payload_sha256", "body_mode", "payload"]
      },
      "rows": [
        {"state": 0, "required_groups": [], "zero_groups": ["execution_binding", "returned_result", "payload"]},
        {"state": 1, "required_groups": ["execution_binding"], "zero_groups": ["returned_result", "payload"]},
        {"state": 2, "required_groups": ["execution_binding", "command_payload"], "zero_groups": ["returned_result"], "payload_rule": "exact 512-byte TRAD/1"},
        {"state": 3, "required_groups": ["execution_binding", "command_payload"], "zero_groups": ["returned_result"], "payload_rule": "exact 512-byte TRAD/1"},
        {"state": 4, "required_groups": ["execution_binding"], "zero_groups": ["returned_result", "payload"]},
        {"state": 5, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 1},
        {"state": 6, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 1},
        {"state": 7, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 2},
        {"state": 8, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 3},
        {"state": 9, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 2},
        {"state": 10, "required_groups": ["execution_binding", "returned_result", "result_payload"], "validation_state": 2},
        {"state": 11, "required_groups": ["execution_binding"], "zero_groups": ["returned_result", "payload"]}
      ],
      "command_payload_rule": "payload_bytes=512, body_mode=INLINE, payload_sha256=SHA-256(payload), dispatch_sha256=SHA-256(payload), payload is an exact semantically valid TRAD/1, and bytes after payload are zero",
      "result_payload_rule": "payload is either the exact inline result or one exact semantically valid TRAF/1; payload_bytes, body_mode, payload_sha256, result_category, return/validation fields, and zero tail must agree",
      "reserved_rule": "flags, worker_role in the frozen v1 slot corpus, reserved bytes 240..255, and every byte after payload through the 4096-byte capacity are zero unless a reviewed schema row explicitly assigns them"
    },
    "payload_rule": "The payload is a closed union. COMMAND_READY contains exact 512-byte TRAD/1 and zero padding. RESULT_READY contains an inline result of at most 4096 bytes or exact 512-byte TRAF/1 and zero padding. Known-session persistent records over 4096 bytes and every session-unknown persistent record use TRAF/1. No truncation, split, path-only representation, nested reference, or off-slot result queue is permitted.",
    "dispatch_retention_rule": "Before replacing TRAD/1, the worker verifies it and the prefix retains its SHA-256 plus every transition identity. The detector reconstructs the byte-exact deterministic TRAD/1 from the immutable admitted alarm envelope, requires equality with dispatch_sha256, and embeds those exact 512 bytes in TRAO/1. No mutable detached dispatch copy is authority.",
    "transition_rule": "The coordinator alone claims EMPTY and publishes COMMAND_READY. The bound worker alone consumes COMMAND_READY and publishes RESULT_READY. The detector consumer validates and enters exactly one committing state. The coordinator alone publishes ACKED after the named durable outcome and then EMPTY while advancing epoch. Every arrow is one release/acquire transition. POISONED has no normal exit and requires sealed TRAR/1 recovery.",
    "transition_binding_rule": "Every transition fixture binds byte-exact before and after slot vectors. slot_index, channel, emission, mapping_incarnation_id, and all still-applicable operation/alarm/worker/call bindings remain equal. slot_epoch remains equal on every legal transition except ACKED -> EMPTY, where it advances by exactly one. A poison transition preserves the current epoch. A transition declaration without both concrete slot vectors is not acceptance evidence.",
    "validation_rule": "Every returned call enters RETURNED_UNVERIFIED then exactly VERIFIED or REJECTED. Initial success requires call_return_qpc and validation_completed_qpc both strictly before the exclusive deadline. At/after is late; no validated result by the terminal deadline is timeout authority.",
    "capacity_rule": "Persistent worker slot count equals alarm_ipc_limits.persistent_slots_per_worker=2. Live worker slot count equals alarm_ipc_limits.live_slots_per_worker=1024. Full detection is one bounded census/CAS attempt and immediately commits the exact PREDISPATCH_FAILED_LIMIT outcome without waiting, allocating, or claiming a slot."
  },
