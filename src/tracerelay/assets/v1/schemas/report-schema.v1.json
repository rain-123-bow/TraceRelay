{
  "schema_version": "tracerelay.plan.verification_report.v1",
  "status": "normative_implementation_plan",
  "serialization": "canonical JSON from wire-format.v1.json",
  "result_source": "one absolute self-contained session directory only",
  "input_preflight_contract": {
    "input_count": 1,
    "input_type": "ABSOLUTE_SELF_CONTAINED_SESSION_DIRECTORY",
    "access_required": ["READ", "DIRECTORY_TRAVERSE"],
    "write_access_required": false,
    "handle_access": "read-only",
    "share_delete": false,
    "supported_filesystem_required": true,
    "runtime_three_root_admission_applies": false,
    "external_state_inputs": [],
    "path_to_final_reparse_traversal": "REJECT_INPUT_ERROR_BEFORE_EVIDENCE_EVALUATION",
    "reparse_kinds_rejected": ["JUNCTION", "SYMBOLIC_LINK", "MOUNT_POINT", "OTHER_REPARSE"],
    "final_handle_proofs": ["DIRECTORY_TYPE", "READABLE", "SUPPORTED_FILESYSTEM", "CANONICAL_FINAL_PATH", "CONTAINMENT", "FILE_IDENTITY", "EXACT_REOPEN_IDENTITY"],
    "pre_evaluation_rejections": ["RELATIVE_PATH", "REPARSE_TRAVERSAL", "ACCESS_DENIED", "UNSUPPORTED_FILESYSTEM", "UNSUPPORTED_VERSION", "ALTERNATE_STREAM", "PATH_BOUND", "ENTRY_BOUND", "FILE_BOUND", "BYTE_BOUND", "DEPTH_BOUND", "TIME_BOUND"],
    "zero_write_rule": "the verifier never requests write access, creates a file, changes metadata, or opens the alarm root, installation runtime root, or current runtime state"
  },
  "top_level_order": [
    "schema_version",
    "result_class",
    "exit_code",
    "authoritative",
    "evaluation_complete",
    "input",
    "identity",
    "scope",
    "assurance",
    "structure",
    "terminal",
    "monitoring",
    "alarms",
    "byte_accounting",
    "reason_counts",
    "sequence_issues",
    "issue_details",
    "truncation"
  ],
  "fields": [
    {"path": "schema_version", "type": "ASCII", "required": true, "constant": "tracerelay.verification_report.v1"},
    {"path": "result_class", "type": "ENUM", "required": true, "values": ["PASS", "INCOMPLETE", "INVALID", "INPUT_ERROR", "INTERNAL_ERROR"]},
    {"path": "exit_code", "type": "U8", "required": true, "mapping": {"PASS": 0, "INCOMPLETE": 1, "INVALID": 2, "INPUT_ERROR": 64, "INTERNAL_ERROR": 70}},
    {"path": "authoritative", "type": "BOOL", "required": true},
    {"path": "evaluation_complete", "type": "BOOL", "required": true},
    {"path": "input.canonical_path", "type": "UTF8", "required": true, "platform_max_utf16_code_units": 32767, "maximum_utf8_bytes": 131068, "encoded_inside_profile_key": "verifier_limits.max_report_mandatory_bytes"},
    {"path": "input.preflight_accepted", "type": "BOOL", "required": true},
    {"path": "input.logical_bytes", "type": "U64", "required": true},
    {"path": "input.files", "type": "U32", "required": true},
    {"path": "input.directory_entries", "type": "U32", "required": true},
    {"path": "identity.installation_id", "type": "UUID16_TEXT", "required": true},
    {"path": "identity.logical_bundle_id", "type": "UUID16_TEXT", "required": true},
    {"path": "identity.session_id", "type": "UUID16_TEXT", "required": true},
    {"path": "identity.service_incarnation_id", "type": "UUID16_TEXT", "required": true},
    {"path": "identity.monitor_incarnation_id", "type": "UUID16_TEXT_OR_NULL", "required": true},
    {"path": "identity.origin_volume_identity", "type": "HEX", "required": true, "max_bytes": 128},
    {"path": "identity.origin_directory_file_identity", "type": "HEX", "required": true, "max_bytes": 64},
    {"path": "identity.profile_id", "type": "ASCII", "required": true, "max_bytes": 128},
    {"path": "identity.profile_sha256", "type": "SHA256_HEX", "required": true},
    {"path": "identity.catalog_version", "type": "ASCII", "required": true, "max_bytes": 32},
    {"path": "identity.catalog_sha256", "type": "SHA256_HEX", "required": true},
    {"path": "identity.schema_sha256", "type": "SHA256_HEX", "required": true},
    {"path": "identity.transport_profile", "type": "ASCII", "required": true, "max_bytes": 64},
    {"path": "scope.observed_boundary", "type": "ASCII", "required": true, "constant": "LOCAL_LOOPBACK_TCP_V1_PROXY_BOUNDARY"},
    {"path": "scope.remote_application_receipt_claimed", "type": "BOOL", "required": true, "constant": false},
    {"path": "assurance.supported_failure_model", "type": "ASCII_ARRAY", "required": true},
    {"path": "assurance.exclusions", "type": "ASCII_ARRAY", "required": true},
    {"path": "structure.committed_record_count", "type": "U64", "required": true},
    {"path": "structure.final_committed_digest", "type": "SHA256_HEX_OR_NULL", "required": true},
    {"path": "structure.partial_tail_bytes", "type": "U64", "required": true},
    {"path": "structure.sequence_complete", "type": "BOOL", "required": true},
    {"path": "terminal.state", "type": "ENUM", "required": true, "values": ["CLEAN", "INCOMPLETE", "UNKNOWN", "ABSENT", "INVALID"]},
    {"path": "terminal.reason_id", "type": "ASCII_OR_NULL", "required": true, "max_bytes": 128},
    {"path": "terminal.clean_predicates", "type": "BOOL_MAP", "required": true},
    {"path": "monitoring.state", "type": "ENUM", "required": true, "values": ["CONTINUOUS_CLOSED", "GAP", "ABSENT", "INVALID", "UNKNOWN"]},
    {"path": "monitoring.last_service_position", "type": "U64_OR_NULL", "required": true},
    {"path": "monitoring.last_monitor_position", "type": "U64_OR_NULL", "required": true},
    {"path": "alarms.linked_count", "type": "U32", "required": true},
    {"path": "alarms.publication_proven", "type": "BOOL", "required": true},
    {"path": "alarms.unproven_count", "type": "U32", "required": true},
    {"path": "alarms.initial_outcome_counts", "type": "U64_MAP", "required": true},
    {"path": "alarms.terminal_outcome_counts", "type": "U64_MAP", "required": true},
    {"path": "byte_accounting.client_to_upstream.observed_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "byte_accounting.client_to_upstream.os_accepted_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "byte_accounting.client_to_upstream.unknown_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "byte_accounting.upstream_to_client.observed_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "byte_accounting.upstream_to_client.os_accepted_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "byte_accounting.upstream_to_client.unknown_ranges", "type": "RANGE_SUMMARY", "required": true},
    {"path": "reason_counts", "type": "ORDERED_REASON_COUNT_ARRAY", "required": true},
    {"path": "sequence_issues", "type": "ORDERED_SEQUENCE_ISSUE_ARRAY", "required": true},
    {"path": "issue_details", "type": "ORDERED_ISSUE_ARRAY", "required": true},
    {"path": "truncation.reason_counts", "type": "SECTION_TRUNCATION", "required": true},
    {"path": "truncation.sequence_issues", "type": "SECTION_TRUNCATION", "required": true},
    {"path": "truncation.issue_details", "type": "SECTION_TRUNCATION", "required": true},
    {"path": "truncation.report_bytes", "type": "U64", "required": true}
  ],
  "compound_types": {
    "RANGE_SUMMARY": {
      "ordered_fields": ["range_count", "total_bytes", "first_offset", "last_offset_exclusive", "digest_sha256"],
      "rule": "ranges are normalized, nonoverlapping, ascending half-open intervals; summary digest is over canonical interval pairs"
    },
    "ORDERED_REASON_COUNT_ARRAY": {
      "entry_fields": ["priority", "reason_id", "class", "count"],
      "ordering": "ascending catalog priority then stable reason ID",
      "max_entries_profile_key": "verifier_limits.max_reason_count_entries"
    },
    "ORDERED_SEQUENCE_ISSUE_ARRAY": {
      "entry_fields": ["role", "file_relative_path", "sequence", "issue_kind"],
      "ordering": "role ID, UTF-8 path bytes, sequence, issue kind",
      "max_entries_profile_key": "verifier_limits.max_sequence_list_entries"
    },
    "ORDERED_ISSUE_ARRAY": {
      "entry_fields": ["priority", "journal_sequence", "direction", "start_offset", "reason_id", "detail"],
      "field_types": {"priority": "U32", "journal_sequence": "U64_OR_NULL", "direction": "DIRECTION_OR_NULL", "start_offset": "U64_OR_NULL", "reason_id": "ASCII", "detail": "CANONICAL_DETAIL_OBJECT"},
      "direction_values": {"1": "CLIENT_TO_UPSTREAM", "2": "UPSTREAM_TO_CLIENT"},
      "detail_fields": ["role", "file_relative_path", "issue_kind", "text"],
      "ordering": "ascending priority; ascending journal_sequence with null last; direction CLIENT_TO_UPSTREAM then UPSTREAM_TO_CLIENT with null last; ascending start_offset with null last; stable reason_id; canonical serialized detail bytes lexicographically",
      "max_entries_profile_key": "verifier_limits.max_issue_details",
      "max_entry_bytes_profile_key": "verifier_limits.max_issue_detail_bytes"
    },
    "SECTION_TRUNCATION": {
      "ordered_fields": ["truncated", "emitted_entries", "omitted_entries", "emitted_bytes", "budget_bytes"],
      "rule": "required even when not truncated"
    }
  },
  "budgets": {
    "total_profile_key": "verifier_limits.max_report_bytes",
    "mandatory_profile_key": "verifier_limits.max_report_mandatory_bytes",
    "reason_counts_profile_key": "verifier_limits.max_report_reason_count_bytes",
    "sequence_issues_profile_key": "verifier_limits.max_report_sequence_list_bytes",
    "issue_details_profile_key": "verifier_limits.max_report_issue_detail_bytes_total",
    "allocation_order": ["mandatory", "reason_counts", "sequence_issues", "issue_details"],
    "mandatory_rule": "Mandatory scalar/object fields and every section truncation object are never omitted. Failure to encode them inside the mandatory budget is INTERNAL_ERROR with no fabricated partial authoritative result.",
    "section_boundary_rule": "An entry is appended only if its complete canonical encoding including separators fits its section and total budgets. No entry is byte-truncated.",
    "exact_total_rule": "canonical encoded report length including terminal LF is at most max_report_bytes"
  },
  "authority_rules": {
    "PASS": "authoritative=true and evaluation_complete=true and all clean predicates true",
    "INCOMPLETE": "authoritative=true and evaluation_complete=true and structure valid",
    "INVALID": "authoritative=true and evaluation_complete=true and at least one invariant invalid",
    "INPUT_ERROR": "authoritative=false and evaluation_complete=false because authoritative input was never accepted",
    "INTERNAL_ERROR": "authoritative=false and evaluation_complete=false; reliably observed defect counts may remain in ordered sections but cannot change the result class"
  },
  "preflight_null_rule": "When input.preflight_accepted is false, every identity field may be JSON null; structural counts are zero; final digest and monitor positions are null; terminal and monitoring states are ABSENT; empty range summaries remain explicit. Once preflight is accepted, only fields whose type ends in _OR_NULL may be null.",
  "version_evolution": "Top-level order, field paths, compound entry order, class/exit mapping, budgets, and truncation rules are immutable for 1.0. Any change requires a reviewed plan amendment and new golden vectors."
}
