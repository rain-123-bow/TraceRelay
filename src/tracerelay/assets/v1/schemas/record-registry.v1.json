  "record_rule": "payload contains every required field exactly once, only declared optional fields, and no other field; header role must be in roles; fields use registry type and maximum",
  "alarm_observation_authority": {
    "format": "TRAO/1",
    "variants": {
      "1": "RETURNED_INLINE",
      "2": "RETURNED_FILE_REFERENCE",
      "3": "RETURNED_REJECTED",
      "4": "INITIAL_LATE_RETURN",
      "5": "TERMINAL_LATE_RETURN",
      "6": "TERMINAL_EMISSION_TIMEOUT_FROZEN",
      "7": "PREDISPATCH_FAILED_LIMIT",
      "8": "RECOVERY_UNPROVEN",
      "9": "ALARM_ENVELOPE_ADMISSION_LIMIT"
    },
    "presence_authority": "batch-027 NORMATIVE_CONTRACTS.md exact closed TRAO/1 group and variant tables",
    "returned_state_rule": "every returned result is RETURNED_UNVERIFIED and becomes exactly VERIFIED or REJECTED at result_validation_completed_at",
    "deadline_rule": "initial success requires call return and complete validation strictly before the exclusive freeze deadline; at or after is INITIAL_LATE_RETURN; no validated terminal result by its deadline is TERMINAL_EMISSION_TIMEOUT_FROZEN",
    "persistent_rule": "known-session persistent result at most 4096 bytes may be RETURNED_INLINE; larger known-session and every session-unknown persistent result use exact verified TRAF/1; session-unknown persistent TRAO/1 body is zero",
    "live_rule": "live result is inline and at most 4096 bytes",
    "failure_rule": "returned failure/rejection carries only its exact TRAO/1 allowed groups and never fabricates commit, endpoint, body, reference, or success artifacts",
    "dispatch_rule": "every attempted channel observation embeds exact 512-byte TRAD/1 where the variant presence row requires DISPATCH",
    "numeric_kind_rule": "IDs 402 through 408 are invalid and cannot be interpreted as alarm observation authority",
    "linkage": "SESSION_ALARM_LINKAGE remains service-journal-only plan-owned kind 409 and binds the exact session, alarm ID/sequence, service and monitor incarnations, detector chain/record/position/copy, frozen tuple, and profile/catalog/schema hashes."
  },
  "state_projection_rules": {
    "CREDENTIAL_ISSUED": "In INSTALLATION_CATALOG, state_from/state_to encode Credential creation to ISSUED and registration state is unchanged. In SERVICE_SESSION, they encode Session CREATING to WAITING.",
    "CREDENTIAL_CLAIMED_ACTIVE_RESERVED": "In INSTALLATION_CATALOG, state_from/state_to encode Credential ISSUED to CLAIMED and the same single record deterministically projects Registration WAITING to CLAIMED plus ACTIVE counters. In SERVICE_SESSION, they encode Session AUTHENTICATING to CONNECTING_UPSTREAM and are a required copy, not the catalog authority.",
    "CREDENTIAL_EXPIRED": "In INSTALLATION_CATALOG, state_from/state_to encode Credential ISSUED to EXPIRED and the same record deterministically projects Registration WAITING to EXPIRED. In SERVICE_SESSION, expiry terminalization uses TERMINAL_INCOMPLETE instead.",
    "CREDENTIAL_REVOKED": "In INSTALLATION_CATALOG, state_from/state_to encode Credential ISSUED to REVOKED and the same record deterministically projects addressable Registration CREATING/WAITING to REVOKED. In SERVICE_SESSION, revoke terminalization uses TERMINAL_INCOMPLETE instead.",
    "REGISTRATION_TERMINALIZED": "state_from is exactly CREATING, WAITING, CLAIMED, EXPIRED, or REVOKED and state_to is TERMINAL; field 18 and selector facts exactly match the already committed session terminal authority; expiry/revoke use their dedicated intermediate projections"
  },
  "credential_prohibition": "No field represents credential plaintext, credential encoding, candidate digest, retained comparison digest, or service HMAC key. Such data is schema-invalid in every persistent role."
}
